---
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import Flower from '../components/Flower.astro';
import EmailThumb from '../components/EmailThumb.astro';
import { brands } from '../data/brands';
import { emailImage } from '../lib/images';

const totalEmails = brands.reduce((n, b) => n + b.emails.length, 0);
const fan = brands.slice(0, 3).map((b) => ({ brand: b, img: emailImage(b.slug, b.emails[0].image) }));
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title="Email Marketing · Gabriela Calbar">
  <section class="hero">
    <Flower color="var(--pink-2)" size={170} spin style="left:-40px; bottom:40px" class="hide-mobile" />
    <Flower color="var(--mint)" size={120} style="right:42%; top:30px" class="hide-mobile" />
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="eyebrow">Portfolio · Email Marketing</p>
        <h1 class="serif">Emails that<br /><span>tell the brand’s</span><br />story</h1>
        <p class="lead">
          A selection of welcome, campaign and abandoned cart emails for beauty, grocery, jewelry and fashion brands.
          Each project shows the goal, the design choices and how everything ties back to the brand identity.
        </p>
        <ul class="stats" aria-label="Summary">
          <li><strong class="serif">{pad(brands.length)}</strong><span>brands</span></li>
          <li><strong class="serif">{pad(totalEmails)}</strong><span>emails</span></li>
          <li><strong class="serif">Klaviyo</strong><span>flows & campaigns</span></li>
        </ul>
        <a href="#brands" class="btn btn--solid">See projects <span aria-hidden="true">↓</span></a>
      </div>

      <div class="hero__fan" aria-hidden="true">
        {fan.map(({ brand, img }, i) => (
          <div class={`fan-card fan-card--${i}`}>
            <EmailThumb src={img} alt="" width={440} height={620} eager />
          </div>
        ))}
      </div>
    </div>
  </section>

  <Marquee text="Email marketing" variant="pink" />

  <section class="brands" id="brands">
    <div class="wrap">
      <div class="section-head">
        <h2 class="serif">Brands</h2>
        <p>Click a brand to see the emails and the thinking behind each one.</p>
      </div>
      <hr class="double-rule" />

      <ul class="brand-grid">
        {brands.map((b, i) => (
          <li>
            <a href={`/${b.slug}/`} class="brand-card">
              <div class="brand-card__frame" style={`background:${b.palette[0]}`}>
                <EmailThumb width={600} height={630} src={emailImage(b.slug, b.emails[0].image)} alt={`${b.name} welcome email`} />
              </div>
              <div class="brand-card__body">
                <span class="brand-card__num serif">{pad(i + 1)}</span>
                <div>
                  <h3 class="serif">{b.name}</h3>
                  <p class="brand-card__seg">{b.segment}</p>
                  <p class="brand-card__tag">{b.tagline}</p>
                  <p class="brand-card__meta">
                    {b.emails.length} emails · {b.emails.map((e) => e.type).join(', ')}
                  </p>
                </div>
              </div>
              <span class="brand-card__cta">View project <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="process">
    <Flower color="var(--pink-2)" size={140} style="right:6%; top:-50px" />
    <div class="wrap">
      <p class="eyebrow">How I approach an email</p>
      <div class="process__grid">
        <article>
          <span class="serif">01</span>
          <h3 class="serif">One goal per email</h3>
          <p>Welcome, campaign or cart recovery: every email has a single main action, and everything else supports it.</p>
        </article>
        <article>
          <span class="serif">02</span>
          <h3 class="serif">Read in seconds</h3>
          <p>Clear hierarchy, short blocks and visible CTAs, because most people skim, and most of them on their phone.</p>
        </article>
        <article>
          <span class="serif">03</span>
          <h3 class="serif">The brand in every detail</h3>
          <p>Colors, type and tone of voice come from each brand’s identity, so the email feels like an extension of the site and the store.</p>
        </article>
      </div>
    </div>
  </section>

  <Marquee text="Every email tells a story" variant="lime" />
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(40px, 7vw, 96px) 0 clamp(56px, 8vw, 110px);
  }
  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .hero .eyebrow { color: var(--green); margin: 0 0 18px; }
  .hero h1 {
    font-size: clamp(52px, 8.4vw, 120px);
    line-height: .92;
    color: var(--green);
    text-transform: uppercase;
    margin: 0 0 28px;
  }
  .hero h1 span {
    font-style: italic;
    text-transform: none;
    color: var(--pink-2);
  }
  .lead { max-width: 52ch; margin: 0 0 32px; }
  .stats {
    list-style: none;
    padding: 0;
    margin: 0 0 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
  }
  .stats li { display: flex; flex-direction: column; }
  .stats strong { font-size: 44px; line-height: 1; color: var(--green); font-weight: 400; }
  .stats span { font-size: 13px; text-transform: uppercase; letter-spacing: .12em; margin-top: 6px; }

  .hero__fan {
    position: relative;
    height: clamp(420px, 46vw, 600px);
  }
  .fan-card {
    position: absolute;
    width: 56%;
    aspect-ratio: 440 / 620;
    border-radius: 999px 999px 24px 24px;
    overflow: hidden;
    box-shadow: 0 30px 60px -30px rgba(44, 74, 31, .45);
    border: 6px solid var(--white);
    background: var(--white);
  }
  .fan-card--0 { left: 0; top: 12%; transform: rotate(-8deg); }
  .fan-card--1 { left: 22%; top: 0; z-index: 2; }
  .fan-card--2 { right: 0; top: 14%; transform: rotate(8deg); }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px 40px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .section-head h2 {
    font-size: clamp(56px, 8vw, 104px);
    line-height: .9;
    margin: 0;
    color: var(--green);
    text-transform: uppercase;
  }
  .section-head p { max-width: 38ch; margin: 0; }

  .brands { padding: clamp(64px, 9vw, 120px) 0; }
  .brand-grid {
    list-style: none;
    padding: 0;
    margin: clamp(40px, 5vw, 64px) 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(40px, 4vw, 56px) clamp(20px, 3vw, 40px);
  }
  .brand-card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    text-decoration: none;

  }
  .brand-card__frame {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1.5px solid var(--green);
    padding: 22px 22px 0;
    display: flex;
    align-items: flex-end;
  }
  .brand-card__frame :global(img) {
    border-radius: 14px 14px 0 0;
    box-shadow: 0 10px 30px -12px rgba(0, 0, 0, .3);
    transition: transform .5s cubic-bezier(.2, .7, .2, 1);
    height: calc(100% + 10px);
    margin-bottom: -10px;
  }
  .brand-card:hover .brand-card__frame :global(img) { transform: translateY(-10px); }
  .brand-card__body { display: flex; gap: 16px; }
  .brand-card__num { font-size: 22px; color: var(--pink-2); line-height: 1.3; }
  .brand-card h3 {
    font-size: clamp(34px, 3.2vw, 44px);
    line-height: 1;
    margin: 0 0 6px;
    color: var(--green);
  }
  .brand-card__seg { margin: 0 0 10px; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; }
  .brand-card__tag { margin: 0 0 8px; }
  .brand-card__meta { margin: 0; font-size: 13px; opacity: .7; }
  .brand-card__cta {
    margin-top: auto;
    align-self: flex-start;
    font-size: 15px;
    font-weight: 500;
    color: var(--green);
    border-bottom: 1.5px solid var(--lime);
    padding-bottom: 2px;
  }
  .brand-card:hover .brand-card__cta { border-color: var(--pink-2); }

  .process {
    position: relative;
    background: var(--green);
    color: var(--cream);
    padding: clamp(64px, 9vw, 112px) 0;
  }
  .process .eyebrow { color: var(--lime); margin: 0 0 36px; }
  .process__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 56px);
    position: relative;
  }
  .process article > span { font-size: 56px; line-height: 1; color: var(--lime); }
  .process h3 {
    font-size: clamp(30px, 3vw, 40px);
    line-height: 1.05;
    margin: 14px 0 12px;
  }
  .process p { margin: 0; opacity: .92; }

  @media (max-width: 1000px) {
    .brand-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 820px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__fan { height: 108vw; max-height: 560px; }
    .process__grid { grid-template-columns: 1fr; }
    :global(.hide-mobile) { display: none; }
  }
  @media (max-width: 560px) {
    .brand-grid { grid-template-columns: 1fr; }
  }
</style>
