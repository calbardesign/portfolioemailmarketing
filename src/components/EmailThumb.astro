---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** largura e altura do recorte (topo do e-mail) */
  width?: number;
  height?: number;
  eager?: boolean;
}
const { src, alt, width = 560, height = 700, eager = false } = Astro.props;
---
<Image
  src={src}
  alt={alt}
  width={width}
  height={height}
  fit="cover"
  position="top"
  format="webp"
  quality={80}
  loading={eager ? 'eager' : 'lazy'}
  class="thumb-img"
/>
<style>
  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
</style>
